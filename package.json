{
  "name": "hunt-tracker",
  "version": "0.1.0",
  "description": "Hunt: Showdown tracker and OBS overlay — a standalone desktop app",
  "main": "./out/main/index.js",
  "author": "mFred",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mfreddi/hunt-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfreddi/hunt-tracker.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "electron-store": "^8.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@primevue/themes": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-prettier": "^10.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-builder-squirrel-windows": "^26.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.20.1",
    "less": "^4.2.0",
    "prettier": "^3.2.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.0",
    "vue": "^3.4.15",
    "vue-tsc": "^3.0.0",
    "vuex": "^4.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0": "^11.0.1"
  }
}
